# Contact form endpoint (Formspree — formspree.io)
# OPTIONAL. Leave it unset and the live form ships: its URL is the default in
# src/lib/contact-form.ts, so no env config is needed to deploy.
# Set it only to point the form at a different Formspree form (a test form, say).
# A value that is not a real https://formspree.io/f/<id> URL — this placeholder
# included — turns the form into a mailto: link instead, so do not copy it as is.
# PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
