# Contact form endpoint (Formspree — free at formspree.io)
# OPTIONAL: the live endpoint is hardcoded as a default in
# src/components/react/ContactForm.tsx, so no env config is needed to deploy.
# Set this only to point the form at a different form (e.g. a test form).
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
