---
/**
 * The page frame, on the Signal Path palette.
 *
 * Two slots and nothing else: `head` for per-page schema, and the default slot for the
 * page body. Nav and Footer are composed by the pages themselves, because /websites
 * needs a different nav and a trimmed footer.
 *
 * The SEO block below is carried over unchanged from the cream direction — the schema,
 * canonical URLs and OG/Twitter tags were correct and are not part of the rebuild.
 */
import '../styles/global.css';
import { yearsElapsed } from '../lib/career';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /**
   * The CollectionPage JSON-LD below describes the homepage's case-study list.
   * Emitting it on every page would tell Google that /websites is also that
   * collection, so secondary pages opt out and supply their own schema through
   * the `head` slot.
   */
  collectionSchema?: boolean;
  /**
   * The Person schema is emitted on every page. On /websites the default
   * "Angular Specialist / Nx / NgRx" version contradicts the page it sits in
   * and is the wrong thing for Google to associate with a local-web-design
   * query, so that page overrides both.
   */
  personJobTitle?: string;
  personKnowsAbout?: string[];
}

const {
  title = 'Noel Sebastian — Senior Web Engineer & Angular Specialist',
  description = `I build high-scale frontends for companies — and fast, reliable websites for growing businesses. ${yearsElapsed()}+ years, deep in the Angular ecosystem, and available for freelance.`,
  ogImage = '/og-image.svg',
  collectionSchema = true,
  personJobTitle = 'Senior Web Engineer & Angular Specialist',
  personKnowsAbout = ['Angular', 'Frontend Engineering', 'Web Performance', 'Nx Monorepos', 'NgRx', 'TypeScript'],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Noel Sebastian',
  jobTitle: personJobTitle,
  url: 'https://www.noel-sebastian.com',
  sameAs: [
    'https://www.linkedin.com/in/noel-seban',
    'https://github.com/noelsebastian22',
    'https://medium.com/@noelsimc69',
  ],
  email: 'noel@noel-sebastian.com',
  knowsAbout: personKnowsAbout,
  workLocation: {
    '@type': 'Place',
    address: { '@type': 'PostalAddress', addressLocality: 'Sydney', addressCountry: 'AU' },
  },
};

const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Noel Sebastian — Portfolio',
  description:
    'Selected case studies and projects by Noel Sebastian, Senior Web Engineer & Angular Specialist.',
  url: 'https://www.noel-sebastian.com',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: [
      { '@type': 'Article', name: 'Winning Group', url: 'https://www.noel-sebastian.com', description: 'E-commerce frontend at scale — Angular v20, Nx monorepo migration.' },
      { '@type': 'Article', name: 'PLUMBER.', url: 'https://plumber.noel-sebastian.com/', description: 'Single-page marketing site for a New York-based plumbing & handyman company.' },
      { '@type': 'Article', name: 'SRT Marine', url: 'https://www.noel-sebastian.com', description: 'Real-time marine control UI at 60fps.' },
      { '@type': 'Article', name: 'QBurst', url: 'https://www.noel-sebastian.com', description: 'Analytics dashboards with D3.js and sub-second latency.' },
    ],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Fonts -->
    <link rel="preload" href="/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-var.woff2" as="font" type="font/woff2" crossorigin />

    <!-- JSON-LD -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
    {collectionSchema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionPageSchema)} />
    )}

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <!-- The signal (spec §6): one whole-curve layer behind everything, spanning the
         document. Decorative, so it is out of the accessibility tree entirely — every
         word it illustrates is in the content it sits behind. -->
    <div id="signal-layer" aria-hidden="true"></div>

    <slot />

    <!--
      The first JavaScript the site has shipped since Phase 0 removed React. Lenis and
      GSAP's ticker come in here, and every later phase hangs off the driver this starts.

      The three inline scripts this replaces — an IntersectionObserver reveal, a scroll
      progress bar, and a hero parallax — were each their own scroll pathway. The scroll
      is the transport now, and it has exactly one.
    -->
    <script>
      import { initScroll } from '../lib/motion/scroll';
      import { onPageProgress } from '../lib/motion/timeline';
      import { createSvgSignal } from '../lib/signal/svg-signal';

      // Order matters: initScroll() starts the shared ticker the trigger runs on.
      initScroll();

      const layer = document.getElementById('signal-layer');
      if (layer) {
        const signal = createSvgSignal(layer);
        onPageProgress((t) => signal.setProgress(t));
      }
    </script>
  </body>
</html>
