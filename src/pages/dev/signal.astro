---
/**
 * Dev-only harness for the 2D SVG signal renderer (Task 2.2).
 *
 * Scaffolding, not product. It exists so the renderer can be driven and screenshotted
 * in isolation of the page, and so motion can be debugged without the rest of the site
 * in the way. Delete before the Phase 9 ship (tracked in BUILD-PLAN.md → Known Gaps —
 * do not remove that note when this page goes).
 *
 * Task 4.5 made the renderer draw the whole curve and dropped its `section` argument.
 * This harness always drove it from *global* scroll progress, so that change made it
 * mean what it already looked like it meant rather than breaking it.
 *
 * Deliberately no Lenis or GSAP: both arrive in Phase 3. A raw scroll listener is correct
 * here, and is what lets this page debug Phase 3 itself rather than depending on it.
 */
import '../../styles/tokens.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>dev: signal</title>
    <style>
      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        background: var(--ground);
        color: var(--type);
        font-family: var(--font-mono);
      }

      /* Plain flow height so the document actually scrolls — several viewport heights. */
      .scroll-spacer {
        height: 500vh;
      }

      /* Pinned to the viewport so the mount stays visible throughout the scroll, and so a
         screenshot taken at scrollY 0 (the only position a `?t=` load ever sees) always
         frames it. */
      #signal-stage {
        position: fixed;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--s-4);
      }

      #signal-mount {
        width: min(1000px, 90vw);
        height: 60vh;
        background: var(--ground-lift);
      }

      #signal-readout {
        font-family: var(--font-mono);
        font-size: 14px;
        color: var(--type);
        background: var(--ground-lift);
        padding: var(--s-2) var(--s-4);
        border-radius: 4px;
        white-space: pre;
      }
    </style>
  </head>
  <body>
    <div id="signal-stage">
      <div id="signal-mount"></div>
      <div id="signal-readout">t = 0.000</div>
    </div>
    <div class="scroll-spacer"></div>

    <script>
      import { createSvgSignal } from '../../lib/signal/svg-signal';

      const mount = document.getElementById('signal-mount');
      const readout = document.getElementById('signal-readout');

      if (!mount) {
        throw new Error('dev/signal: #signal-mount not found');
      }

      // No dim rule: there is no text here to protect, and the harness has to be legible.
      const signal = createSvgSignal(mount, { dimOffGutter: false });

      function report(t: number, mode: 'query' | 'scroll'): void {
        if (readout) readout.textContent = `t = ${t.toFixed(3)}  ·  mode = ${mode}`;
      }

      const requestedT = new URLSearchParams(window.location.search).get('t');
      const parsedT = requestedT === null || requestedT.trim() === '' ? NaN : Number(requestedT);

      if (Number.isFinite(parsedT)) {
        // A screenshot cannot scroll: with a usable `t` in the URL, set progress directly
        // and skip the scroll listener entirely.
        const clamped = Math.min(1, Math.max(0, parsedT));
        signal.setProgress(clamped);
        report(clamped, 'query');
      } else {
        // No `t`, or an unparseable one — drive from scroll position, straight off
        // window.scrollY like the plan specifies. No Lenis, no GSAP, no rAF throttling:
        // this harness has to work before either exists.
        const computeT = (): number => {
          const max = document.body.scrollHeight - window.innerHeight;
          const raw = max > 0 ? window.scrollY / max : 0;
          return Math.min(1, Math.max(0, raw));
        };

        const onScroll = (): void => {
          const t = computeT();
          signal.setProgress(t);
          report(t, 'scroll');
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }
    </script>
  </body>
</html>
