---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import NineYears from '../components/NineYears.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Ring from '../components/Ring.astro';
import Stack from '../components/Stack.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <!-- overflow-x:clip, not hidden: `hidden` forces the paired axis (overflow-y) to compute
       to `auto`, which makes this div a scroll container of its own — Nav's
       `position: sticky` then sticks to it instead of the viewport. `clip` still stops the
       ring's wide scroller from opening up horizontal page scroll, without creating one. -->
  <div id="top" style="overflow-x:clip">
    <Nav />
    <!-- tabindex="-1": #main-content has no natural focus target of its own, so without
         this the skip link's href="#main-content" only scrolls — document.activeElement
         stays on <body> and a screen reader announces nothing. -1 keeps it out of the
         normal Tab order (it is reachable only by the skip link's own jump) while making
         it a real focus target once that jump lands. -->
    <main id="main-content" tabindex="-1">
    <Hero />
    <NineYears />
    <SelectedWork />
    <Ring />
    <Stack />
    <Contact />
    </main>
    <Footer />
  </div>
</BaseLayout>
