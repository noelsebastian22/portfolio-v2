---
/**
 * Nav for /websites. Separate from Nav.astro because that one's links point at
 * the root-domain sections — reusing it here would give a business owner a menu
 * of pages about Angular experience.
 *
 * The one link back to the portfolio is deliberately quiet and last. Anyone who
 * wants the engineering CV will find it; nobody is pushed toward it.
 */
import { websitesNav } from '../data/websites';
---

<nav
  class="nav-anim-entrance sticky top-0 z-50 border-b border-ink/[0.09]"
  style="backdrop-filter:blur(10px);background:rgba(243,240,232,.82)"
>
  <div class="mx-auto flex max-w-[1200px] items-center justify-between gap-6 px-6 py-4 md:px-10">
    <a
      href="#top"
      class="font-bricolage text-[22px] font-extrabold leading-none tracking-[-0.5px] text-ink no-underline"
    >
      NOEL S<span class="text-accent">.</span>
    </a>

    <div class="hidden items-center gap-[26px] lg:flex">
      {websitesNav.map((l) => (
        <a
          href={l.href}
          class="font-mono text-[12.5px] uppercase tracking-[1px] text-ink-secondary no-underline transition-colors duration-200 hover:text-accent"
        >
          {l.label}
        </a>
      ))}
    </div>

    <a
      href="#contact"
      class="hidden items-center gap-2 rounded-full bg-accent px-[22px] py-3 text-sm font-bold text-white no-underline transition-all duration-200 hover:-translate-y-0.5 hover:bg-ink md:inline-flex"
    >
      Get a quote →
    </a>

    <button
      id="wnav-btn"
      class="flex flex-col gap-1.5 p-2 lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="wnav-menu"
    >
      <span class="block h-0.5 w-6 bg-ink"></span>
      <span class="block h-0.5 w-6 bg-ink"></span>
      <span class="block h-0.5 w-6 bg-ink"></span>
    </button>
  </div>

  <div id="wnav-menu" hidden class="border-t border-ink/10 bg-cream px-[1.8rem] py-6 lg:hidden">
    <div class="flex flex-col gap-4">
      {websitesNav.map((l) => (
        <a
          href={l.href}
          class="font-mono text-[13px] uppercase tracking-[1px] text-ink-secondary no-underline"
        >
          {l.label}
        </a>
      ))}
      <a
        href="#contact"
        class="mt-2 inline-flex w-fit items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-bold text-white no-underline"
      >
        Get a quote →
      </a>
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    var btn = document.getElementById('wnav-btn');
    var menu = document.getElementById('wnav-menu');
    if (!btn || !menu) return;

    function setOpen(open) {
      menu.hidden = !open;
      btn.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    }

    btn.addEventListener('click', function () {
      setOpen(menu.hidden);
    });

    menu.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        setOpen(false);
      });
    });

    // Escape closes it, and focus goes back to the trigger.
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        btn.focus();
      }
    });
  })();
</script>
