---
/**
 * The footer, and the end of the signal.
 *
 * Spec §6: the line terminates in a `|` completion bar, and the footer is where it
 * lands — the curve's last control point is `x: 0, y: 1`, dead centre at the very
 * bottom of the document. The bar is therefore centred and is the last thing in the
 * page, so the two meet rather than merely appearing in the same region.
 *
 * It is drawn across the transport rather than along it. Marble diagrams run left to
 * right, which is why the notation is a vertical `|`; this one runs top to bottom, so
 * the same mark perpendicular to the line is horizontal. Collinear with the line it
 * would be invisible.
 */
import { socials } from '../data/content';

interface Props {
  /**
   * Overridable because /websites must not describe its author as an "Angular
   * Specialist" — that is recruiter vocabulary and it undoes the whole point of
   * having a separate client page if it turns up in the footer.
   */
  tagline?: string;
  /** Hidden on /websites: GitHub and Medium are not signals a tradie is reading for. */
  showSocials?: boolean;
  /** Hidden for the same reason: a stack colophon is written for another developer. */
  showColophon?: boolean;
}

const {
  tagline = 'Senior Web Engineer & Angular Specialist · Sydney, AU',
  showSocials = true,
  showColophon = true,
} = Astro.props;

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__head">
      <div>
        <div class="site-footer__name">Noel Sebastian</div>
        <p class="site-footer__tagline">{tagline}</p>
      </div>
      <a class="site-footer__email" href="mailto:noel@noel-sebastian.com">
        noel@noel-sebastian.com
      </a>
    </div>

    <div class="site-footer__meta">
      <p class="site-footer__copy">© {year} Noel Sebastian · Available for freelance</p>
      {showSocials && (
        <ul class="site-footer__socials">
          {socials.map((social) => (
            <li>
              <a class="site-footer__link" href={social.href} target="_blank" rel="noopener noreferrer">
                {social.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    {showColophon && (
      <p class="site-footer__colophon">
        Astro · TypeScript · GSAP · Lenis · self-hosted variable fonts. No UI framework.
      </p>
    )}
  </div>

  <!-- The completion bar. Decorative: the signal's end state is also stated in words
       above it, so nothing here is the sole carrier of meaning. -->
  <div class="site-footer__complete" aria-hidden="true"></div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid color-mix(in srgb, var(--type) 10%, transparent);
  }

  .site-footer__inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--s-9) var(--s-5) var(--s-7);
  }

  .site-footer__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s-6);
    padding-bottom: var(--s-6);
    border-bottom: 1px solid color-mix(in srgb, var(--type) 10%, transparent);
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 800;
    letter-spacing: -0.5px;
  }

  .site-footer__tagline {
    margin: var(--s-2) 0 0;
    color: var(--type-dim);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .site-footer__email {
    padding-bottom: var(--s-1);
    border-bottom: 2px solid var(--signal);
    color: var(--type);
    font-family: var(--font-display);
    font-size: clamp(18px, 2.2vw, 28px);
    font-weight: 700;
    text-decoration: none;
  }

  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4) var(--s-6);
    padding-top: var(--s-5);
  }

  .site-footer__copy,
  .site-footer__colophon {
    margin: 0;
    color: var(--type-dim);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .site-footer__colophon {
    padding-top: var(--s-5);
  }

  .site-footer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__link {
    color: var(--type-dim);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: color 0.2s;
  }

  .site-footer__link:hover {
    color: var(--shipped);
  }

  /* Centred and flush with the bottom edge, because that is precisely where the curve
     terminates: x 0 maps to 50% of the signal layer's width, y 1 to its last pixel. */
  .site-footer__complete {
    width: var(--s-9);
    height: var(--signal-stroke);
    margin: 0 auto;
    background: var(--signal);
  }
</style>
