---
/**
 * The footer, and the end of the signal.
 *
 * Spec §6: the line terminates in a `|` completion bar, at the top of the footer
 * (Decisions, 2026-09-26 — "The line ends above the footer, not under it"). The
 * curve's last control point is `x: 0, y: 1` in `path.ts`'s own space, but that maps
 * to this bar's measured centre, not to the document's last pixel: `svg-signal.ts`
 * queries `[data-signal-terminus]` and hands its centre to `resolveSeamPixels` as the
 * terminus, so the curve and the bar meet by measurement rather than by both simply
 * being at the bottom.
 *
 * It is drawn across the transport rather than along it. Marble diagrams run left to
 * right, which is why the notation is a vertical `|`; this one runs top to bottom, so
 * the same mark perpendicular to the line is horizontal. Collinear with the line it
 * would be invisible.
 */
import { socials } from '../data/content';

interface Props {
  /**
   * Overridable because /websites must not describe its author as an "Angular
   * Specialist" — that is recruiter vocabulary and it undoes the whole point of
   * having a separate client page if it turns up in the footer.
   */
  tagline?: string;
  /** Hidden on /websites: GitHub and Medium are not signals a tradie is reading for. */
  showSocials?: boolean;
  /** Hidden for the same reason: a stack colophon is written for another developer. */
  showColophon?: boolean;
}

const {
  tagline = 'Senior Web Engineer & Angular Specialist · Sydney, AU',
  showSocials = true,
  showColophon = true,
} = Astro.props;

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <!-- The completion bar, first so it can sit on the footer's top edge. Decorative: the
       signal's end state is also stated in words below it, so nothing here is the sole
       carrier of meaning. -->
  <div class="site-footer__complete" data-signal-terminus aria-hidden="true"></div>

  <div class="site-footer__inner">
    <div class="site-footer__head">
      <div>
        <div class="site-footer__name">Noel Sebastian</div>
        <p class="site-footer__tagline">{tagline}</p>
      </div>
      <a class="site-footer__email" href="mailto:noel@noel-sebastian.com">
        noel@noel-sebastian.com
      </a>
    </div>

    <div class="site-footer__meta">
      <p class="site-footer__copy">© {year} Noel Sebastian · Available for freelance</p>
      {showSocials && (
        <ul class="site-footer__socials" role="list">
          {socials.map((social) => (
            <li>
              <a class="site-footer__link" href={social.href} target="_blank" rel="noopener noreferrer">
                {social.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    {showColophon && (
      <p class="site-footer__colophon">
        Astro · TypeScript · GSAP · Lenis · self-hosted variable fonts. No UI framework.
      </p>
    )}
  </div>
</footer>

<style>
  .site-footer {
    /* Named so the completion bar's margin math (below) can share the same width the
       border itself is drawn at, instead of repeating the literal in two places. */
    --footer-hairline: 1px;

    border-top: var(--footer-hairline) solid color-mix(in srgb, var(--type) 10%, transparent);
  }

  .site-footer__inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--s-9) var(--s-5) var(--s-7);
  }

  .site-footer__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s-6);
    padding-bottom: var(--s-6);
    border-bottom: 1px solid color-mix(in srgb, var(--type) 10%, transparent);
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 800;
    letter-spacing: -0.5px;
  }

  .site-footer__tagline {
    margin: var(--s-2) 0 0;
    color: var(--type-dim);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .site-footer__email {
    padding-bottom: var(--s-1);
    border-bottom: 2px solid var(--signal);
    color: var(--type);
    font-family: var(--font-display);
    font-size: clamp(18px, 2.2vw, 28px);
    font-weight: 700;
    text-decoration: none;
  }

  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4) var(--s-6);
    padding-top: var(--s-5);
  }

  .site-footer__copy,
  .site-footer__colophon {
    margin: 0;
    color: var(--type-dim);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .site-footer__colophon {
    padding-top: var(--s-5);
  }

  .site-footer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__link {
    color: var(--type-dim);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: color 0.2s;
  }

  .site-footer__link:hover {
    color: var(--shipped);
  }

  /* Centred (x 0 is the signal layer's centre) and sitting astride the footer's own
     top-edge hairline, because that is where `svg-signal.ts` measures this element's
     centre line as the curve's terminus (`measureTerminus`, `resolveSeamPixels`) — the
     two meet here by measurement, not because both happen to be at the same fixed edge.
     Without this box, the flow cursor entering `.site-footer__inner` sits one
     hairline below the footer's own top edge (the border, with no padding on
     `.site-footer` before it). Pulling the bar up by half its own height plus that
     hairline (margin-block-start) centres it exactly on the footer's top edge, astride
     the border; pushing margin-block-end back down by the same hairline, less that
     same half-height, cancels the net height this box would otherwise add to the
     flow. The two margins are unequal but sum with the height to zero for any stroke
     or hairline width, so `.site-footer__inner` starts, and the footer ends, exactly
     where they would if this bar were not here. */
  .site-footer__complete {
    width: var(--s-9);
    height: var(--signal-stroke);
    margin-inline: auto;
    margin-block: calc(var(--signal-stroke) / -2 - var(--footer-hairline))
      calc(var(--footer-hairline) - var(--signal-stroke) / 2);
    background: var(--signal);
  }
</style>
