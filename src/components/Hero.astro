---
/**
 * Section 01 — the hero. Spec §9.01.
 *
 * Reading order is the recruiting order: what he is available for, whether he can be
 * hired here, where he is — then the claim, then the proof of the claim, then the two
 * things a hiring manager can do about it. Work rights sit in the rail on purpose:
 * recruiters filter on them early and hard, and burying it costs interviews.
 *
 * Everything here is server-rendered except the clock's numerals, which cannot be —
 * this is a static build, so a baked numeral is a lie by the time anyone reads it. The
 * rail therefore ships a word ("local time") where the numerals will land, sized to the
 * same width, so the line scans complete with JavaScript off and nothing moves when the
 * island fills it in. See `src/islands/hero.ts`.
 *
 * The portrait is mounted bare — no panel, no border, no radius, no shadow. Task 5.1
 * dissolved its edges to exactly `--ground`, so any frame drawn around it would be a
 * frame around an asset engineered to have none. It does carry a mask, for the opposite
 * reason: see `.hero__face`. On a capable desktop, Phase 11's particles are sampled from
 * this still's pixels and drawn over it (`src/lib/gfx/scene.ts`); `hero--particles` then
 * drops it to a rest opacity under them, and it erodes with them on scroll.
 */
import { status } from '../data/content';

/**
 * The portrait panel is ~600 CSS px on a 1440 container, which is what Task 5.1's
 * 640/1280 scales were baked for. Held to 86vw and below on phones so the 2x file is
 * not fetched onto a device that cannot show the detail.
 */
const PORTRAIT_SIZES = '(max-width: 600px) 86vw, (max-width: 960px) 420px, (max-width: 1200px) 42vw, 600px';
const PORTRAIT_BASE = '/images/portrait/portrait';
---

<header class="hero" id="hero" data-signal-section="hero">
  <div class="hero__inner">
    <div class="hero__copy">
      <ul class="hero__rail" role="list">
        <li class="hero__rail-item">
          <span class="hero__live" aria-hidden="true"></span>{status.availability}
        </li>
        <li class="hero__rail-item">{status.workRights}</li>
        <li class="hero__rail-item">
          {status.city}
          <!-- Replaced with HH:MM:SS on mount. The placeholder is a word, not a numeral,
               so nothing here can be mistaken for a stale reading of the clock. -->
          <span class="hero__clock" data-hero-clock data-timezone={status.timezone}>local time</span>
        </li>
      </ul>

      <h1 class="hero__title">
        <!-- Two blocks rather than one run: left to wrap freely the separator orphans
             itself onto the start of a line, which reads as a bullet rather than as the
             join between two titles. -->
        <span class="hero__title-part">Senior Web Engineer <span class="hero__sep">·</span></span>
        <span class="hero__title-part">Angular Specialist</span>
      </h1>

      <p class="hero__lede">
        I architect high-scale frontends in the Angular ecosystem — Nx monorepos, NgRx,
        signals. And I work at the front of AI-augmented development, using
        <span class="hero__mark">Model Context Protocol (MCP) servers and Figma Code Connect</span>
        to shorten the path from design to production code.
      </p>

      <div class="hero__ctas">
        <a class="hero__cta hero__cta--primary" href="#work">
          See the work <span aria-hidden="true">↓</span>
        </a>
        <a class="hero__cta hero__cta--ghost" href="/noel-sebastian.pdf" download>
          Download CV
        </a>
      </div>
    </div>

    <figure class="hero__portrait">
      <picture>
        <source
          type="image/avif"
          sizes={PORTRAIT_SIZES}
          srcset={`${PORTRAIT_BASE}-640w.avif 640w, ${PORTRAIT_BASE}-1280w.avif 1280w`}
        />
        <source
          type="image/webp"
          sizes={PORTRAIT_SIZES}
          srcset={`${PORTRAIT_BASE}-640w.webp 640w, ${PORTRAIT_BASE}-1280w.webp 1280w`}
        />
        <img
          class="hero__face"
          data-portrait-still
          src={`${PORTRAIT_BASE}-640w.jpg`}
          sizes={PORTRAIT_SIZES}
          srcset={`${PORTRAIT_BASE}-640w.jpg 640w, ${PORTRAIT_BASE}-1280w.jpg 1280w`}
          width="640"
          height="640"
          alt="Noel Sebastian"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <figcaption class="hero__caption">01 · of('Noel Sebastian')</figcaption>
    </figure>
  </div>
</header>

<style>
  .hero {
    /* Not 100vh: a hero that exactly fills the viewport reads as a slide, and this one
       has a section under it that should show its first line. */
    padding-block: clamp(var(--s-7), 7vw, var(--s-10)) clamp(var(--s-8), 9vw, var(--s-11));
  }

  .hero__inner {
    display: grid;
    gap: clamp(var(--s-7), 5vw, var(--s-9));
    align-items: center;
    max-width: var(--container);
    /* Matches the nav's own padding, so the brand mark and the H1 share one left edge. */
    margin-inline: auto;
    padding-inline: var(--s-5);
  }

  @media (min-width: 961px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    }
  }

  /* ── Status rail ─────────────────────────────────────────────────────────────── */

  .hero__rail {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-3);
    margin: 0 0 var(--s-6);
    padding: 0;
    list-style: none;
    color: var(--type-dim);
    font-family: var(--font-mono);
    font-size: 12px;
    /* 0.06em, not the 0.08em the rest of the mono voice uses: tracking is applied to
       every character, so at 0.08em the three items measure 716px inside a 713px column
       and the rail wraps at exactly the width it is designed for. */
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Separators are pseudo-elements so the rail reads as three facts to a screen reader
     rather than as three facts and two middle dots. Trailing rather than leading: a
     wrapped line then begins with a word instead of with a dot, which otherwise reads
     as a broken bullet list at every width where the rail does not fit on one line. */
  .hero__rail-item:not(:last-child)::after {
    content: '·';
    margin-left: var(--s-3);
    color: color-mix(in srgb, var(--type-dim) 55%, transparent);
  }

  .hero__live {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: var(--s-2);
    border-radius: 50%;
    background: var(--signal);
    /* Static. A blinking dot would be the one thing on this page animating on a timer. */
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--signal) 22%, transparent);
  }

  .hero__clock {
    display: inline-block;
    /* The slot is sized to its widest occupant — the server-rendered "local time", 10
       characters — so the 8-character time that replaces it lands inside a box that
       never changes. The tracking is in the calc because letter-spacing is added after
       every character, including the last: measured, 10ch alone reserved 72px for a
       label that actually renders 82px wide, and the rail wrapped with JS off and not
       with it on. CLS on this page is 0 and stays 0. */
    min-width: calc(10ch + 0.6em);
    color: var(--type);
    font-variant-numeric: tabular-nums;
  }

  /* ── Headline ────────────────────────────────────────────────────────────────── */

  .hero__title {
    /* Archivo Expanded — verified live, not assumed: at 64px the 125% instance renders
       25% wider than 100%, which is why the size below is smaller than it looks. */
    margin: 0 0 var(--s-5);
    color: var(--type);
    font-family: var(--font-display);
    /* 5.4vw, not the 6.1 it started at: measured at 1100px the larger step pushed
       "SENIOR WEB" onto two lines and the headline to five, with "WEB" alone on one of
       them. At this step every width from 960 up breaks it into the same four lines. */
    font-size: clamp(38px, 5.4vw, 78px);
    font-stretch: 125%;
    font-weight: 700;
    line-height: 0.94;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .hero__title-part {
    display: block;
  }

  /* The separator the spec puts in the H1, read as what it is on this site: an emission
     on the line. Large text, so --signal is inside its §7.1 restriction. */
  .hero__sep {
    color: var(--signal);
  }

  .hero__lede {
    max-width: 56ch;
    margin: 0 0 var(--s-7);
    color: var(--type-dim);
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.6;
  }

  /* The single most differentiating line on the resume (spec §9.01), so it is the one
     phrase in the paragraph that is not dim, underscored in the signal colour. */
  .hero__mark {
    color: var(--type);
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  /* ── Calls to action ─────────────────────────────────────────────────────────── */

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-5);
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }

  .hero__cta--primary {
    background: var(--signal);
    color: var(--ground);
    font-weight: 700;
  }

  .hero__cta--primary:hover {
    background: var(--type);
  }

  /* The global focus ring is --signal, which on a --signal button leaves only the 2px
     offset to read. Cream separates from both the button and the ground. */
  .hero__cta--primary:focus-visible {
    outline-color: var(--type);
  }

  .hero__cta--primary span {
    transition: transform 0.2s;
  }

  .hero__cta--primary:hover span {
    transform: translateY(2px);
  }

  .hero__cta--ghost {
    border-color: color-mix(in srgb, var(--type) 24%, transparent);
    color: var(--type);
  }

  .hero__cta--ghost:hover {
    border-color: var(--type);
    background: color-mix(in srgb, var(--type) 8%, transparent);
  }

  /* ── Portrait ────────────────────────────────────────────────────────────────── */

  .hero__portrait {
    margin: 0;
    /* No panel, no border, no radius, no shadow — see the file header. */
  }

  .hero__face {
    width: 100%;
    max-width: 600px;
    height: auto;
    /* The page grain (`body::after`) paints above content (`--z-grain`, moved there
       2026-09-24 — see global.css), so an opaque element still punches a grain-free hole
       in it: the grain layer covers the viewport, but the portrait's own pixels win
       wherever it sits on top. Measured on this page: the ground reads 15,14,13 with
       grain and the portrait's dissolved corners 10,9,7 without it.
       Small, but it is a hard-edged rectangle in a dark field, which is the one kind of
       difference the eye finds reliably — and a boundary around an asset Task 5.1 built
       to have none.

       The fix is to stop the element being a rectangle. Its outer band is already flat
       `--ground` (the asset's own border fade), so masking that band away costs no
       picture and lets the grain run straight through where the edge used to be.
       `farthest-side` puts the mask's radii on the mid-edges, so the corners — where a
       rectangle reads loudest — fall outside it entirely.

       Screen-blending was the first thing I tried and it is wrong here: the asset
       dissolves to `--ground`, not to black, so screen adds a ground to a ground and
       the corners came out 22,21,18 — a lighter rectangle instead of a darker one. */
    -webkit-mask-image: radial-gradient(farthest-side at 50% 45%, #000 86%, transparent 100%);
    mask-image: radial-gradient(farthest-side at 50% 45%, #000 86%, transparent 100%);
    transition: opacity 400ms ease-out;
  }

  /* Phase 11 (design R1): with the particles drawn over it, the still drops to a rest opacity
     rather than leaving — it carries the likeness 40k particles cannot — and a second mask
     layer hides it from the bottom up exactly as fast as the particles leave (D12).
     `--portrait-erosion` (0..1) is written by scene.ts; the gradient's 10% feather is why the
     edge runs to 110%. Opacity and mask, not display: the box stays, because the particles are
     placed on it. */
  .hero--particles .hero__face {
    opacity: 0.4;
    -webkit-mask-image:
      radial-gradient(farthest-side at 50% 45%, #000 86%, transparent 100%),
      linear-gradient(
        to top,
        transparent calc(var(--portrait-erosion, 0) * 110% - 10%),
        #000 calc(var(--portrait-erosion, 0) * 110%)
      );
    -webkit-mask-composite: source-in;
    mask-image:
      radial-gradient(farthest-side at 50% 45%, #000 86%, transparent 100%),
      linear-gradient(
        to top,
        transparent calc(var(--portrait-erosion, 0) * 110% - 10%),
        #000 calc(var(--portrait-erosion, 0) * 110%)
      );
    mask-composite: intersect;
  }

  .hero__caption {
    max-width: 600px;
    margin-top: var(--s-3);
    /* Centred under the frame rather than flush left: the mask above dissolves the
       picture's corners, so its visual left edge is no longer the box's left edge and a
       flush-left caption reads as floating beside the portrait rather than under it. */
    text-align: center;
    color: var(--type-dim);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
  }

  @media (max-width: 960px) {
    .hero__face,
    .hero__caption {
      max-width: 420px;
    }
  }

  @media (max-width: 620px) {
    /* Wrapped, the rail's separators lead lines 2 and 3, which indents them past the
       first and reads as a broken bullet list. Below this width the rail is a stack of
       three plain lines instead. */
    .hero__rail {
      flex-direction: column;
      gap: var(--s-2);
    }

    .hero__rail-item:not(:last-child)::after {
      content: none;
    }
  }

  @media (max-width: 600px) {
    .hero__face,
    .hero__caption {
      max-width: 100%;
    }
  }
</style>

<script>
  import { mountHeroClock } from '../islands/hero';

  mountHeroClock();
</script>
