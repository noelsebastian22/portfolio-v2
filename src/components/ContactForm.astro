---
/**
 * The contact form itself — extracted from Contact.astro (Task 9.5+ final review, I4) so
 * `/websites`'s quote form can be the same markup instead of a second, drifting copy.
 *
 * **The form works with JS off.** Its `action` is resolved here, at build time:
 * `PUBLIC_FORMSPREE_ENDPOINT`, else the live form, and `mailto:` only when neither is a
 * usable Formspree URL (Decisions, 2026-09-26). A native POST lands on Formspree's own
 * confirmation page; the browser shows its own constraint messages. `contact-form.ts` adds
 * inline messages and an in-place sent/failed state on top.
 *
 * Field names are what Formspree records: `name`, `email` (Formspree's reply-to), `message`
 * and `lookingFor` — the names the old React form sent, so new submissions land in the same
 * columns as old ones. `_gotcha` is Formspree's honeypot.
 */
import { resolveFormEndpoint } from '../lib/contact-form';
import type { LookingFor } from '../lib/contact-form';

interface Props {
  /** Preselects "I'm looking for": the radio matching this value ships already checked. */
  lookingFor?: LookingFor;
  /** Prefixes every id, so two instances can coexist on one page without collisions. */
  idPrefix?: string;
}

const { lookingFor, idPrefix = 'contact' } = Astro.props;

const endpoint = resolveFormEndpoint(import.meta.env.PUBLIC_FORMSPREE_ENDPOINT);
// A mailto: form with JS off posts its fields as the email body; plain text reads.
const enctype = endpoint.startsWith('mailto:') ? 'text/plain' : undefined;
---

<form class="form" data-contact-form method="post" action={endpoint} enctype={enctype}>
  <fieldset class="form__choice">
    <legend class="form__label">I'm looking for (optional)</legend>
    <div class="form__options">
      <label class="form__option">
        <input type="radio" name="lookingFor" value="role" checked={lookingFor === 'role'} />
        <span>A role</span>
      </label>
      <label class="form__option">
        <input type="radio" name="lookingFor" value="project" checked={lookingFor === 'project'} />
        <span>A project</span>
      </label>
    </div>
  </fieldset>

  <div class="form__pair">
    <div class="form__field">
      <label class="form__label" for={`${idPrefix}-name`}>Name</label>
      <input
        class="form__input"
        id={`${idPrefix}-name`}
        name="name"
        type="text"
        required
        minlength="2"
        autocomplete="name"
      />
      <p class="form__error" id={`${idPrefix}-name-error`} data-error-for="name"></p>
    </div>
    <div class="form__field">
      <label class="form__label" for={`${idPrefix}-email`}>Email</label>
      <input
        class="form__input"
        id={`${idPrefix}-email`}
        name="email"
        type="email"
        required
        autocomplete="email"
        spellcheck="false"
      />
      <p class="form__error" id={`${idPrefix}-email-error`} data-error-for="email"></p>
    </div>
  </div>

  <div class="form__field">
    <label class="form__label" for={`${idPrefix}-message`}>Message</label>
    <textarea
      class="form__input form__input--area"
      id={`${idPrefix}-message`}
      name="message"
      rows="6"
      required
      minlength="10"></textarea>
    <p class="form__error" id={`${idPrefix}-message-error`} data-error-for="message"></p>
  </div>

  {/* Formspree's honeypot. display: none takes it out of sight, out of the tab order
      and out of the accessibility tree; it is still submitted, so a bot that fills
      every input fills this one too. */}
  <div class="form__gotcha">
    <label>Leave this empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="form__foot">
    <button class="form__submit" type="submit">Send message</button>
    {/* Always rendered, so it is already in the accessibility tree when the island
        first writes to it; a live region that appears with its text is often missed. */}
    <p class="form__status" role="status" data-form-status></p>
  </div>
</form>

<style>
  /* Native controls (the radios, the textarea's resize grip) drawn for a dark ground
     rather than as white discs. Opaque, like the ring's cards, since this can sit over the
     contact span (see Contact.astro). */
  .form {
    /* Local to this component (not read off an ancestor like Contact.astro's `--emission`),
       so the form looks the same wherever it is dropped in — including /websites, which has
       no `.contact` wrapper of its own to inherit a custom property from. */
    --field-border: var(--type-dim);

    color-scheme: dark;

    display: grid;
    gap: var(--s-5);
    padding: var(--s-5);
    border: 1px solid color-mix(in srgb, var(--type) 10%, transparent);
    border-radius: var(--radius);
    background: var(--ground-lift);
  }

  @media (min-width: 600px) {
    .form {
      padding: var(--s-6);
    }
  }

  .form__label {
    display: block;
    margin-bottom: var(--s-2);
    padding: 0;
    color: var(--type-dim);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
  }

  .form__choice {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .form__options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
  }

  .form__option {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    min-height: var(--s-7);
    color: var(--type);
    font-size: 16px;
    cursor: pointer;
  }

  /* Native radios, tinted: the dot is a graphic, so --signal is allowed. */
  .form__option input {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--signal);
  }

  .form__pair {
    display: grid;
    gap: var(--s-5);
  }

  @media (min-width: 600px) {
    .form__pair {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form__field {
    min-width: 0;
  }

  /* --type-dim edges: 5.05:1 on --ground-lift, so the field's boundary clears the 3:1
     non-text minimum on its own. */
  .form__input {
    display: block;
    width: 100%;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--field-border);
    border-radius: var(--radius);
    background: var(--ground);
    color: var(--type);
    font-size: 16px;
    line-height: 1.5;
  }

  .form__input:hover {
    --field-border: var(--type);
  }

  .form__input--area {
    resize: vertical;
  }

  /* The edge carries the invalid state as a graphic; the message under it carries it in
     words (§13). */
  .form__input[aria-invalid='true'] {
    --field-border: var(--signal);

    box-shadow: inset 3px 0 0 var(--signal);
  }

  .form__error {
    margin: var(--s-2) 0 0;
    color: var(--type);
    font-size: 14px;
    line-height: 1.4;
  }

  .form__error:empty {
    display: none;
  }

  .form__gotcha {
    display: none;
  }

  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-5);
  }

  /* The section's CTA — the one --signal fill here, like the hero's primary. */
  .form__submit {
    padding: var(--s-4) var(--s-6);
    border: 0;
    border-radius: var(--radius);
    background: var(--signal);
    color: var(--ground);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s;
  }

  .form__submit:hover {
    background: var(--type);
  }

  /* The global ring is --signal; on a --signal button only its offset would read. */
  .form__submit:focus-visible {
    outline-color: var(--type);
  }

  .form__submit[aria-disabled='true'] {
    cursor: progress;
  }

  .form__status {
    flex: 1 1 16rem;
    margin: 0;
    color: var(--type);
    font-size: 15px;
    line-height: 1.5;
  }

  /* The failure message's link is written by the island, so it carries no scoped
     attribute: reached with :global, styled the same as Contact.astro's other links. */
  .form__status :global(a) {
    color: var(--type);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--type) 35%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition: text-decoration-color 0.2s;
  }

  .form__status :global(a:hover) {
    text-decoration-color: currentColor;
  }
</style>
