---
/**
 * Section 04 — the shipped sites, as the 2D rail. Spec §9.04.
 *
 * This is the ring's fallback, built first: the presentation on phones, short windows, under
 * reduced motion and with `?signal=2d` (Phase 12 builds the 3D ring over the same cards). Same
 * cards, same content, same links in both, so everything here is server-rendered and the island
 * only adds behaviour.
 *
 * **The split is a track.** §6 has the line split into five at the ring, one branch per
 * card. In 2D that is a horizontal track above the rail, the signal's own weight and
 * colour, which the curve meets exactly where it reaches the centre: the track's centre
 * line carries `data-signal-split`, and the renderer pins control point `RING_SPLIT_POINT`
 * to it (anchors.ts), so the meeting point holds whatever the section's height. From the
 * track, each card hangs on a short drop ending in a `--shipped` emission — yellow means
 * shipped (§6), and the card says it in words as well (§13). The track is static; the
 * drops live inside the scroller, so they slide with their cards natively and horizontal
 * scrolling needs no script. Below the track the curve carries on down the centre, behind
 * the cards: they are opaque, and the dim rule already dims the line wherever it is not
 * clear of content.
 *
 * The track and drops are drawn in full in the HTML. With JS off, or under reduced motion,
 * the split is complete; the island moves it back to undrawn and draws it off the tip.
 *
 * **The 3D mode** (Phase 12, revision R4) is these same cards, restyled, in CSS 3D — no WebGL.
 * The script below loads `lib/ring/stage.ts` after load and idle when its gate passes
 * (`lib/ring/gate.ts`: wide enough, no reduced motion, not `?signal=2d`); the stage adds
 * `.ring--3d` when the ring fits the window, and only while the section is off screen, because
 * the class changes the page's height. The rail grows by the pin length and the scroller becomes
 * a sticky, one-viewport stage in which each card gets a `matrix3d` from `lib/ring/geometry.ts`.
 * There is no hoop and no drop: the 2D track and drops are hidden, and the line lands on the
 * front card's emission, which stays on its card. The meeting point is `[data-signal-split]` in
 * both modes. In the rail it is the visible track. In 3D the track is hidden and moved to the
 * front card's top-centre, kept in the rail rather than the sticky stage, so it measures where
 * the curve should pass and not where the stage is stuck. `[data-signal-hold="end"]` ends the
 * line's straight hold below the split: the cards' bottom edge in the rail, and the same stage
 * height at the pin's end in 3D, so the line runs straight down the centre for the whole pin.
 * Removing the class restores the rail exactly (resize below the fit, or any failure).
 *
 * Layout is the plain content box, as 01–02 use: no signal gutter, because below 03 the line
 * runs through the centre rather than down a spine in the margin (Decisions, 2026-10-03).
 * The rail alone bleeds past the box's right edge to the viewport's, so the next card
 * visibly runs off the page. Never left: the cards start where the heading does.
 */
import { ringProjects } from '../data/content';
import captures from '../data/ring-captures.json';

type Capture = (typeof captures)[keyof typeof captures];
const manifest: Record<string, Capture> = captures;

/**
 * The card's widest rendered width, in CSS px, and its frame's height as a fraction of
 * its width (4:3). Both are handed to the CSS as custom properties below, so the layout,
 * the `sizes` attribute and the hover-scroll timing read one number each.
 */
const CARD_MAX_PX = 400;
const FRAME_RATIO = 0.75;

/** The frame is the card less its 1px border either side. */
const FRAME_MAX_PX = CARD_MAX_PX - 2;

/**
 * The hover-scroll runs at a constant speed, so a long page takes longer than a short one
 * and every capture reads as the same camera move. Measured at the card's full width;
 * a narrower card travels proportionally less in the same time. The return is quicker —
 * leaving a card should not make you watch it rewind.
 */
const SCROLL_PX_PER_S = 400;
const RETURN_PX_PER_S = 1600;

const seconds = (value: number) => `${value.toFixed(2)}s`;

/** The counter's two digits: `01 / 05`. */
const pad = (value: number) => String(value).padStart(2, '0');

const cards = ringProjects.map((project) => {
  const capture = manifest[project.slug];
  if (!capture) {
    // tests/ring-captures.test.ts catches this first; this keeps the build honest too.
    throw new Error(`Ring: no capture for "${project.slug}" in ring-captures.json`);
  }
  const frameHeight = FRAME_MAX_PX * FRAME_RATIO;
  const imageHeight = FRAME_MAX_PX * (capture.height / capture.width);
  const travel = Math.max(0, imageHeight - frameHeight);
  return {
    ...project,
    capture,
    host: new URL(project.site).hostname,
    titleId: `ring-${project.slug}-title`,
    hostId: `ring-${project.slug}-host`,
    scrollIn: seconds(travel / SCROLL_PX_PER_S),
    scrollOut: seconds(travel / RETURN_PX_PER_S),
  };
});

/** The frame's rendered width: 80vw on a phone, the card's max past 500px. */
const SIZES = `(max-width: 500px) calc(80vw - 2px), ${FRAME_MAX_PX}px`;

const srcset = (urls: Record<string, string>) =>
  Object.entries(urls)
    .map(([width, url]) => `${url} ${width}w`)
    .join(', ');
---

<section
  class="ring"
  id="ring"
  data-ring
  data-signal-section="ring"
  style={`--ring-card-max: ${CARD_MAX_PX}px; --ring-frame: ${FRAME_RATIO};`}
>
  <div class="ring__inner">
    <header class="ring__head">
      <p class="ring__marker">04 — mergeMap()</p>
      <h2 class="ring__title">Sites, shipped</h2>
      <p class="ring__lede">
        The freelance side: sites for real businesses, and one product of my own. Every card
        opens the live site — hover or focus one to run through the whole page.
      </p>
    </header>

    <div class="ring__rail">
      {/* The split. Its centre line is the curve's anchor (`data-signal-split`); the two
          halves let the island draw it outward from wherever the curve meets it. */}
      <div class="ring__track" data-signal-split aria-hidden="true">
        <span class="ring__track-half ring__track-half--left" data-track-half="left"></span>
        <span class="ring__track-half ring__track-half--right" data-track-half="right"></span>
      </div>

      {/* Lenis turns wheel input into page scroll; a horizontal gesture over the rail is
          the rail's, so it is left native. */}
      <div class="ring__scroller" data-lenis-prevent-horizontal>
        <ul class="ring__cards" role="list">
          {cards.map((card) => (
            <li class="card" style={`--scroll-in: ${card.scrollIn}; --scroll-out: ${card.scrollOut};`}>
              <span class="card__drop" data-drop aria-hidden="true"></span>
              <span class="card__emit" data-emit aria-hidden="true"></span>

              <a
                class="card__link"
                data-card-link
                href={card.site}
                target="_blank"
                rel="noopener noreferrer"
                {/* Host first, title second: that is the visual reading order (the chrome
                    bar sits above the frame, the title below it), and axe's
                    label-content-name-mismatch flagged the reverse — the computed name
                    read "title host" while the visible text reads "host … title". */}
                aria-labelledby={`${card.hostId} ${card.titleId}`}
                aria-describedby="new-tab-note"
              >
                <div class="card__chrome">
                  <span class="card__host" id={card.hostId}>{card.host}</span>
                </div>
                <div class="card__frame">
                  <picture>
                    <source type="image/avif" srcset={srcset(card.capture.avif)} sizes={SIZES} />
                    <source type="image/webp" srcset={srcset(card.capture.webp)} sizes={SIZES} />
                    <img
                      class="card__capture"
                      src={card.capture.webp['480']}
                      width={card.capture.width}
                      height={card.capture.height}
                      alt={`Full-page capture of the ${card.title} site`}
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                </div>
                <h3 class="card__title" id={card.titleId}>{card.title}</h3>
              </a>

              <p class="card__desc">{card.desc}</p>
              <p class="card__tagline">{card.tagline}</p>

              <div class="card__foot">
                <p class="card__state">
                  <span class="card__state-mark" aria-hidden="true"></span>
                  shipped · live
                </p>
                {card.repo && (
                  <a
                    class="card__repo"
                    href={card.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-describedby="new-tab-note"
                  >
                    Source on GitHub<span class="card__sr"> for {card.title}</span>
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>

        {/* The 3D ring's counter and dots (revision R4), under the front card. Outside the
            card list's 3D context, so they never depth-sort with the cards. Shown only in 3D:
            in the rail every card is already in reach, and the buttons would do nothing. */}
        <nav class="ring__nav" aria-label="Shipped sites" data-ring-nav>
          <p class="ring__count" aria-hidden="true"><span data-ring-count>01</span> / {pad(cards.length)}</p>
          <ul class="ring__dots" role="list">
            {cards.map((card, i) => (
              <li>
                <button type="button" class="ring__dot" data-ring-dot={i} aria-label={`Show ${card.title}`}></button>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      {/* Where the line's hold below the split ends (anchors.ts, RING_HOLD_END_POINT): the
          cards' bottom edge in the rail, the pin's end in 3D. */}
      <span class="ring__hold-end" data-signal-hold="end" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  .ring {
    --ring-card: min(var(--ring-card-max), 80vw);
    /* How far each card hangs below the track. */
    --ring-drop: var(--s-7);
    --ring-emit: 10px;

    padding-block: var(--section-y);
  }

  /* The plain content box, as 01–02 use: no signal gutter. Only 03's spine runs down the
     margin, so only SelectedWork.astro reserves it (and the dim rule's gutter ends there). */
  .ring__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--s-5);
  }

  /* ── Section head — the house voice, as SelectedWork sets it ────────────────────── */

  .ring__marker,
  .ring__lede {
    margin: 0;
  }

  /* Not uppercased: `mergeMap()` is an operator, and an operator in capitals stops being
     an identifier. */
  .ring__marker {
    color: var(--type-dim);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
  }

  .ring__title {
    max-width: 18ch;
    margin: var(--s-4) 0;
    color: var(--type);
    font-family: var(--font-display);
    font-size: clamp(32px, 4.2vw, 62px);
    font-stretch: 125%;
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .ring__lede {
    max-width: 52ch;
    color: var(--type-dim);
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.6;
  }

  /* ── The rail ───────────────────────────────────────────────────────────────────── */

  /* Out past the content box's right edge to the viewport's: the box's own right padding,
     plus the centring margin once the viewport is wider than the container. */
  .ring__rail {
    margin-top: clamp(var(--s-8), 7vw, var(--s-10));
    margin-right: calc(-1 * max(var(--s-5), (100vw - var(--container)) / 2 + var(--s-5)));
  }

  /* The track: the signal's weight and colour, across the rail's whole visible width.
     `--split-x` is where the curve meets it — the island sets it from the curve itself;
     until then the halves meet mid-track, which with JS off draws the same full line. */
  .ring__track {
    --split-x: 50%;

    position: relative;
    height: var(--signal-stroke);
  }

  .ring__track-half {
    position: absolute;
    top: 0;
    bottom: 0;
    background: var(--signal);
  }

  .ring__track-half--left {
    left: 0;
    width: var(--split-x);
    border-radius: var(--signal-stroke) 0 0 var(--signal-stroke);
    transform-origin: right center;
  }

  .ring__track-half--right {
    left: var(--split-x);
    right: 0;
    border-radius: 0 var(--signal-stroke) var(--signal-stroke) 0;
    transform-origin: left center;
  }

  /* Drawn by script per tip move, so never transitioned: global.css's reduced-motion net
     would otherwise turn each write into a 1ms transition (see SelectedWork.astro). */
  .ring__track-half,
  .card__drop,
  .card__emit {
    transition-property: none;
  }

  /* Starts on the track's centre line, so each drop grows straight out of it. The top
     padding is the drops' room: inside the scroller, so they slide with their cards.
     The left padding and matching scroll-padding hold a snapped card one focus ring
     (2px outline + 2px offset, global.css) inside the rail's edge, so the first card's
     ring is never clipped by the scroller. */
  .ring__scroller {
    margin-top: calc(var(--signal-stroke) / -2);
    padding: var(--ring-drop) 0 var(--s-5) var(--s-1);
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-left: var(--s-1);
    scrollbar-color: color-mix(in srgb, var(--type-dim) 60%, transparent) transparent;
    scrollbar-width: thin;
  }

  .ring__cards {
    display: flex;
    gap: var(--s-6);
    width: max-content;
    margin: 0;
    /* So the last card can clear the viewport's edge rather than sit on it. */
    padding: 0 var(--s-5) 0 0;
    list-style: none;
  }

  /* Zero-height: only its top edge is read, as the curve's anchor. */
  .ring__hold-end {
    display: block;
    height: 0;
  }

  /* ── A card ─────────────────────────────────────────────────────────────────────── */

  .card {
    position: relative;
    display: flex;
    flex: 0 0 var(--ring-card);
    flex-direction: column;
    width: var(--ring-card);
    border: 1px solid color-mix(in srgb, var(--type) 10%, transparent);
    border-radius: var(--radius);
    background: var(--ground-lift);
    scroll-snap-align: start;
  }

  .card__drop {
    position: absolute;
    bottom: 100%;
    left: 50%;
    width: var(--signal-stroke);
    height: var(--ring-drop);
    margin-left: calc(var(--signal-stroke) / -2);
    background: var(--signal);
    transform-origin: center top;
  }

  /* On the card's top edge, over its border. */
  .card__emit {
    position: absolute;
    z-index: 1;
    top: calc(var(--ring-emit) / -2 - 0.5px);
    left: 50%;
    width: var(--ring-emit);
    height: var(--ring-emit);
    margin-left: calc(var(--ring-emit) / -2);
    border-radius: 50%;
    background: var(--shipped);
  }

  .card__link {
    display: block;
    border-radius: var(--radius) var(--radius) 0 0;
    color: var(--type);
    text-decoration: none;
  }

  /* Browser chrome in markup (Decisions, 2026-09-25): it holds still while the capture
     scrolls under it, and it shows the real domain as text. */
  .card__chrome {
    display: flex;
    align-items: center;
    height: var(--s-6);
    padding-inline: var(--s-3);
    border-bottom: 1px solid color-mix(in srgb, var(--type) 10%, transparent);
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--ground);
  }

  .card__host {
    overflow: hidden;
    color: var(--type-dim);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* A fixed window onto a long page. A container, so the capture can be moved by exactly
     its own height less the frame's: `cqi` is the frame's width here. */
  /* `min-height: 0` because `overflow: clip` is not a scroll container, so the automatic
     minimum an aspect-ratio box gets would otherwise grow it to the capture's full height. */
  .card__frame {
    aspect-ratio: 1 / var(--ring-frame);
    min-height: 0;
    overflow: clip;
    container-type: inline-size;
    background: var(--ground);
  }

  .card__capture {
    width: 100%;
    height: auto;
    transition: transform var(--scroll-out) ease-out;
  }

  /* The hover-scroll: the capture slides up until the page's bottom meets the frame's,
     at a constant speed (the duration is set per card from its height). `transform`
     only, so it runs on the compositor. Pointer or focus drives it, which §7.4 allows;
     under reduced motion there is no scroll and the capture stays at its top. */
  @media (prefers-reduced-motion: no-preference) {
    .card__link:hover .card__capture,
    .card__link:focus-visible .card__capture {
      transform: translateY(calc(-100% + 100cqi * var(--ring-frame)));
      transition: transform var(--scroll-in) linear;
    }
  }

  .card__title {
    margin: 0;
    padding: var(--s-4) var(--s-4) 0;
    font-family: var(--font-display);
    font-size: clamp(20px, 1.6vw, 24px);
    font-stretch: 112%;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  /* Large text (bold, over 18.66px), so --signal is within its rule here. */
  .card__link:hover .card__title,
  .card__link:focus-visible .card__title {
    color: var(--signal);
  }

  .card__desc,
  .card__tagline,
  .card__state {
    margin: 0;
  }

  .card__desc {
    padding: var(--s-3) var(--s-4) 0;
    color: var(--type);
    font-size: 15px;
    line-height: 1.55;
  }

  .card__tagline {
    padding: var(--s-3) var(--s-4) 0;
    color: var(--type-dim);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  /* Pinned to the card's bottom, so the state lines up along the rail. */
  .card__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-4);
    margin-top: auto;
    padding: var(--s-5) var(--s-4) var(--s-4);
  }

  /* §13: colour is never the only carrier of state — the words say it too. */
  .card__state {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--type-dim);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  .card__state-mark {
    width: var(--s-2);
    height: var(--s-2);
    border-radius: 50%;
    background: var(--shipped);
  }

  .card__repo {
    color: var(--type);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--type) 40%, transparent);
    text-underline-offset: 3px;
  }

  .card__repo:hover {
    text-decoration-color: currentColor;
  }

  .card__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ── The 3D ring (Phase 12) — on only while lib/ring/stage.ts has mounted it ─────── */

  /* The rail grows by the pin; the stage sticks for that distance (design D6). */
  .ring--3d .ring__rail {
    position: relative;
    height: calc(100vh + var(--ring-pin, 0px));
  }

  /* The meeting point and the hold's end stay in the rail, never in the sticky stage: the
     renderer measures them with getBoundingClientRect, and a stuck element measures where it
     is stuck, not where the curve should pass. */
  .ring--3d .ring__track {
    position: absolute;
    top: var(--ring-front-y, 0px);
    left: 0;
    right: 0;
    margin-top: calc(var(--signal-stroke) / -2);
    visibility: hidden;
  }

  /* The 3D swap changes these two boxes, and stage.ts reads the section's height in the
     same task as it drops the ring, to hold a reader who is past it in place. Under reduced
     motion global.css's net would make each change a 1ms transition, and the read would get the
     3D box (72px short at 1280). Neither has a transition of its own. */
  .ring__track,
  .ring__scroller {
    transition-property: none;
  }

  .ring--3d .ring__hold-end {
    position: absolute;
    top: calc(var(--ring-front-y, 0px) + var(--ring-pin, 0px));
    left: 0;
  }

  .ring--3d .ring__scroller {
    position: sticky;
    top: 0;
    height: 100vh;
    margin: 0;
    padding: 0;
    overflow: visible;
    scroll-snap-type: none;
  }

  /* The line ends at the front card's dot. While pinned it would carry on down the centre to
     its tip, and below a card shorter than the stage that tip glowed under it. The line is
     below the page (z −1), so a panel of the ground from the front point to the stage's
     bottom hides it there — inside the stuck stage only: above the dot, and once the pin
     releases, the line is untouched. First in the stage and with no z-index, so the cards and
     the nav paint over it; the grain paints over both it and the page alike. */
  .ring--3d .ring__scroller::before {
    position: absolute;
    top: var(--ring-front-y, 0px);
    right: 0;
    bottom: 0;
    left: 0;
    background: var(--ground);
    content: '';
    pointer-events: none;
  }

  /* One 3D context for all five, so they depth-sort; stage.ts sets its perspective. */
  .ring--3d .ring__cards {
    position: absolute;
    inset: 0;
    width: auto;
    padding: 0;
    perspective: var(--ring-perspective, 1000px);
    perspective-origin: var(--ring-origin-x, 50%) var(--ring-origin-y, 50%);
    transform-style: preserve-3d;
    /* The list's own box is the 3D context's z = 0 plane, in front of every side card (they
       sit behind the front one): it would take their hover and their clicks. The cards take
       pointer events themselves; the stage under the list still takes the drag. */
    pointer-events: none;
  }

  .ring--3d .card {
    pointer-events: auto;
  }

  /* Each card's top-centre sits on the front point; stage.ts writes its matrix3d. */
  .ring--3d .card {
    position: absolute;
    top: var(--ring-front-y, 0px);
    left: var(--ring-front-x, 50%);
    margin-left: calc(var(--ring-card) / -2);
    transform-origin: 50% 0;
    backface-visibility: hidden;
    will-change: transform, opacity;
  }

  .ring--3d .card--inert {
    pointer-events: none;
  }

  /* Depth without a filter (cost): the side cards recede under the ground, the front one stands
     off it on a soft, low shadow. stage.ts writes `--ring-dim` (0 dead front, rising a step
     round; 1 before the cards arrive, which come up out of the ground) and `--ring-lit` (1 dead
     front, 0 half a step round) per drawn frame. Both drive pseudo-elements' opacity only. */
  .ring--3d .card::before,
  .ring--3d .card::after {
    position: absolute;
    border-radius: inherit;
    content: '';
    pointer-events: none;
  }

  /* Under the card, so only the shadow outside its box shows. */
  .ring--3d .card::before {
    z-index: -1;
    inset: 0;
    box-shadow: 0 40px 80px -32px color-mix(in srgb, black 70%, transparent);
    opacity: var(--ring-lit, 0);
  }

  /* Over everything on the card, its emission and border included. */
  .ring--3d .card::after {
    z-index: 2;
    inset: -1px;
    /* Out by the border, so its corners are rounder by as much, or the border's corners show. */
    border-radius: calc(var(--radius) + 1px);
    background: var(--ground);
    opacity: var(--ring-dim, 0);
  }

  /* The line lands on the front card's dot: lit, a touch larger, with a soft glow. */
  .ring--3d .card__emit {
    /* Half of it sits above the card, out of the overlay's reach: it recedes with its card. */
    opacity: calc(1 - var(--ring-dim, 0));
    box-shadow: 0 0 12px 2px color-mix(in srgb, var(--shipped) calc(55% * var(--ring-lit, 0)), transparent);
    transform: scale(calc(1 + 0.25 * var(--ring-lit, 0)));
  }

  /* Dragging the stage turns the ring (stage.ts); the link still reads as a link. */
  .ring--3d .ring__scroller {
    cursor: grab;
  }

  .ring--3d .card__link {
    cursor: pointer;
  }

  /* The front card's title in --signal, as on hover (large text). */
  .ring--3d .card--front .card__title {
    color: var(--signal);
  }

  /* A drag that starts on a card must turn the ring, not drag out its image. */
  .ring--3d .card img {
    -webkit-user-drag: none;
    user-select: none;
  }

  /* No drops in 3D: the line lands on the front card's emission, which stays on its card. */
  .ring--3d .card__drop {
    display: none;
  }

  /* ── The counter and dots (revision R4) — 3D only ─────────────────────────────────── */

  .ring__nav {
    display: none;
  }

  /* Flat in the stage, under the front card and as wide as it: the counter under its text's
     left edge, the dots under its right. The middle stays clear, because the line runs on down
     the centre below the card and its tip can show there. stage.ts sets `--ring-nav-y` from
     geometry.ts's stageLayout, which reserves NAV_HEIGHT_PX — this row's height — for it, and
     `--ring-scale`, the ring's. It comes up with the cards as they arrive (`--ring-arrive`),
     and a focused dot is always shown in full. */
  .ring--3d .ring__nav {
    position: absolute;
    top: var(--ring-nav-y, 100%);
    left: var(--ring-front-x, 50%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: calc(var(--ring-card) * var(--ring-scale, 1));
    height: 24px;
    padding-inline: var(--s-4);
    transform: translateX(-50%);
    opacity: var(--ring-arrive, 1);
    cursor: auto;
  }

  .ring--3d .ring__nav:focus-within {
    opacity: 1;
  }

  .ring__count {
    margin: 0;
    color: var(--type-dim);
    font-family: var(--font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  /* The card in front reads first; the count out of five recedes. */
  .ring__count [data-ring-count] {
    color: var(--type);
  }

  /* Out by the hit area's margin round the dot, so the last dot's edge, not its target's, lines
     up with the card's text. */
  .ring__dots {
    display: flex;
    margin: 0 -8px 0 0;
    padding: 0;
    list-style: none;
  }

  /* A 24px target (WCAG 2.2) round an 8px dot. */
  .ring__dot {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
  }

  .ring__dot::before {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--type) 30%, transparent);
    content: '';
    transition: background-color 0.2s ease-out;
  }

  .ring__dot:hover::before {
    background: color-mix(in srgb, var(--type) 60%, transparent);
  }

  .ring__dot[aria-current='true']::before {
    background: var(--signal);
  }
</style>

<script>
  import { mountRing } from '../islands/ring';
  import { canTurnRing } from '../lib/ring/gate';

  mountRing();

  // Phase 12: the 3D ring, decided only once the page is loaded and idle (as BaseLayout does
  // for the tube), so it never touches first paint. Its code is behind this import, in no
  // initial chunk. Whether it fits the window is the stage's own check.
  function startRing(): void {
    const section = document.querySelector<HTMLElement>('[data-ring]');
    const canTurn = canTurnRing({
      viewportWidth: document.documentElement.clientWidth,
      reducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      search: location.search,
    });
    if (!section || !canTurn) return;
    import('../lib/ring/stage')
      .then(({ mountRingStage }) => mountRingStage({ section }))
      .catch(() => {
        // A failed chunk load, or a mount that threw before switching on: the rail was never
        // touched, so there is nothing to undo.
      });
  }
  const whenIdle = (fn: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(fn) : fn());
  if (document.readyState === 'complete') whenIdle(startRing);
  else window.addEventListener('load', () => whenIdle(startRing), { once: true });
</script>
