---
/**
 * The site nav — minimal, persistent, and zero JavaScript.
 *
 * Spec §9: the CV download is always visible. It is the primary conversion for a
 * hiring manager, so it never goes behind a menu and never collapses at phone width;
 * at narrow widths the section links wrap onto their own row instead. That wrap is
 * also why there is no hamburger: a disclosure menu is a behaviour, and behaviour here
 * would be an island rendering navigation that the server can render outright.
 *
 * The sound toggle is present but inert until Phase 13 builds the audio graph. It is
 * rendered `disabled` with `aria-pressed="false"` rather than wired to a handler that
 * does nothing — a control that responds but changes nothing is worse than one that
 * plainly is not ready yet.
 */
import { nav } from '../data/content';
---

<nav class="site-nav" aria-label="Primary">
  <div class="site-nav__inner">
    <a class="site-nav__brand" href="#top">
      <img src="/favicon.svg" width="26" height="26" alt="" />
      <span class="site-nav__name">Noel Sebastian</span>
    </a>

    <ul class="site-nav__links" role="list">
      {nav.map((link) => (
        <li>
          <a class="site-nav__link" href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>

    <div class="site-nav__actions">
      <button
        class="site-nav__sound"
        type="button"
        aria-pressed="false"
        disabled
        title="Sound design arrives in a later build"
      >
        Sound off
      </button>
      <a class="site-nav__cv" href="/noel-sebastian.pdf" download>
        Download CV
      </a>
    </div>
  </div>
</nav>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    border-bottom: 1px solid color-mix(in srgb, var(--type) 10%, transparent);
    /* Fallback first: color-mix is well supported, but a nav with no background at all
       would let the signal line run through the links. */
    background: var(--ground);
    background: color-mix(in srgb, var(--ground) 84%, transparent);
    backdrop-filter: blur(10px);
  }

  .site-nav__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4) var(--s-5);
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--s-4) var(--s-5);
  }

  .site-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--type);
    text-decoration: none;
  }

  .site-nav__name {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.2px;
  }

  .site-nav__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    color: var(--type-dim);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .site-nav__link:hover {
    color: var(--type);
  }

  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }

  .site-nav__sound,
  .site-nav__cv {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .site-nav__sound {
    padding: var(--s-2) var(--s-3);
    border: 1px solid color-mix(in srgb, var(--type) 16%, transparent);
    border-radius: var(--radius);
    background: none;
    color: var(--type-dim);
  }

  .site-nav__sound[disabled] {
    /* Reads as not-yet rather than broken: still legible, plainly not operable. */
    opacity: 0.55;
    cursor: not-allowed;
  }

  /* --signal on a CTA is exactly what §7.1 reserves it for. --ground on it rather than
     white, so the label keeps the 6.05:1 the palette was measured at. */
  .site-nav__cv {
    padding: var(--s-2) var(--s-4);
    border-radius: var(--radius);
    background: var(--signal);
    color: var(--ground);
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s;
  }

  .site-nav__cv:hover {
    background: var(--type);
  }

  /* The global focus ring is --signal, which on a --signal CTA leaves only the 2px
     offset gap to read. Cream separates from both the button and the ground. */
  .site-nav__cv:focus-visible {
    outline-color: var(--type);
  }

  @media (max-width: 768px) {
    /* The links take their own row so the brand and the CV keep the first one. Order
       matters more than space here — the CV never moves and never collapses. */
    .site-nav__links {
      order: 3;
      flex-basis: 100%;
      gap: var(--s-4);
      font-size: 11px;
    }

    .site-nav__inner {
      padding: var(--s-3) var(--s-4);
    }
  }

  @media (max-width: 560px) {
    /* Measured: brand name, sound toggle and CV together overrun 390px and the CV was
       the half that got clipped. The name goes to assistive tech only — the mark still
       carries it, and the hero says it in 80px type a moment later. Clipped, not
       display:none, so the brand link keeps an accessible name. */
    .site-nav__name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .site-nav__actions {
      gap: var(--s-2);
    }
  }
</style>
