---
/**
 * Section 03 — the four enterprise case studies, each as problem / approach / result with
 * a generated diagram. Spec §9.03.
 *
 * Diagrams, not screenshots: these are internal systems, usually under NDA, and a chart of
 * the claim persuades a technical lead more than a login page does. Every number in a
 * diagram comes from the study's `diagram` field in `content.ts`, which a test holds to
 * the resume; nothing here is typed as a literal.
 *
 * Each diagram is server-rendered at its END state — the true claim — so a visitor with
 * JavaScript off, or with reduced motion, sees the finished chart and never a half-drawn
 * one. The island moves it back to its start on mount and scrubs forward on scroll. The
 * SVG is `aria-hidden`; the `<figcaption>` says the same thing in words, with the numbers,
 * and is what a screen reader gets.
 *
 * Layout is against the signal's gutter (spec §7.3): a centred `--container` padded by
 * `--s-5`, plus `padding-left: var(--signal-gutter)`. That is exactly the content box the
 * renderer's gutter probe assumes (`.signal-gutter-probe` in global.css), so the line's lit
 * run and the content agree on where content starts. Change one, change both.
 */
import { caseStudies } from '../data/content';
import { yearsElapsed } from '../lib/career';
import type { CaseStudyDiagram } from '../lib/diagrams/types';
import { frametimeGeometry } from '../lib/diagrams/frametime';
import { scatterGeometry } from '../lib/diagrams/scatter';
import { gridPaths } from '../lib/diagrams/scatter-figure';
import {
  BUNDLE_BAR,
  DEPLOY_BAR,
  FRAME_BASELINE_Y,
  PLOT_LEFT,
  PLOT_RIGHT,
  VIEW_HEIGHT,
  VIEW_WIDTH,
  bundleFrame,
  deployFrame,
  frameTimeY,
  repoConvergePoint,
  repoSegments,
  round2,
} from '../lib/diagrams/figure';
import { bundleBarAt } from '../lib/diagrams/bundle';
import { deployBarAt } from '../lib/diagrams/repos';

/** Two-digit study index, the card's attachment point for its branch. */
const indexLabel = (i: number) => String(i + 1).padStart(2, '0');

/** en-US grouping, so the count reads 1,000,000 whatever locale the build runs in. */
const COUNT = new Intl.NumberFormat('en-US');

/**
 * The figure caption: the diagram's claim as a sentence, with its numbers, built from the
 * same data the drawing is. This is the accessible content — the SVG beside it is hidden.
 */
function caption(diagram: CaseStudyDiagram): string {
  switch (diagram.kind) {
    case 'bundle': {
      const from = bundleBarAt(diagram, 0).percent;
      const to = bundleBarAt(diagram, 1).percent;
      return `Bundle size, ${from}% → ${to}%: ${diagram.reductionPercent}% smaller after the migration.`;
    }
    case 'repos': {
      const from = deployBarAt(diagram, 0).minutes;
      const to = deployBarAt(diagram, 1).minutes;
      return `${diagram.repoLabel} repositories converging on one NgRx state architecture, and deploys cut from ${from} to ${to} minutes — the bars are drawn at true scale.`;
    }
    case 'frametime': {
      const ms = frametimeGeometry(diagram).frameTimeMs.toFixed(1);
      return `Frame time holding flat on the ${ms} ms budget, a steady ${diagram.fps}fps. The trace draws the claim, not recorded samples.`;
    }
    case 'scatter':
      return `${COUNT.format(diagram.pointCount)} points, binned into a density grid and resolving from coarse to fine. The count is real; the distribution is illustrative.`;
  }
}

/** Everything each figure needs, computed once here at progress 1 — the end state. */
const studies = caseStudies.map((study, i) => {
  const diagram = study.diagram;
  const base = { ...study, index: indexLabel(i), caption: caption(diagram) };
  switch (diagram.kind) {
    case 'bundle':
      return { ...base, bundle: { end: bundleFrame(diagram, 1), start: bundleFrame(diagram, 0) } };
    case 'repos':
      return {
        ...base,
        repos: {
          label: diagram.repoLabel,
          segments: repoSegments(diagram, 1),
          converge: repoConvergePoint(diagram),
          deploy: deployFrame(diagram, 1),
          deployStart: deployFrame(diagram, 0),
        },
      };
    case 'frametime': {
      const geometry = frametimeGeometry(diagram);
      const points = geometry.points.map((p) => ({
        x: round2(PLOT_LEFT + p.x * (PLOT_RIGHT - PLOT_LEFT)),
        y: frameTimeY(p.y, geometry.frameTimeMs),
      }));
      return {
        ...base,
        frametime: {
          d: points.map((p, j) => `${j === 0 ? 'M' : 'L'}${p.x} ${p.y}`).join(''),
          budgetY: frameTimeY(geometry.frameTimeMs, geometry.frameTimeMs),
          end: points[points.length - 1],
          msLabel: `${geometry.frameTimeMs.toFixed(1)} ms`,
          fpsLabel: `${diagram.fps}fps`,
        },
      };
    }
    case 'scatter': {
      const geometry = scatterGeometry(diagram);
      return {
        ...base,
        scatter: { coarse: gridPaths(geometry.coarse), fine: gridPaths(geometry.fine) },
      };
    }
  }
});

const viewBox = `0 0 ${VIEW_WIDTH} ${VIEW_HEIGHT}`;
---

<section class="work" id="work" data-work data-signal-section="work">
  <div class="work__inner">
    <header class="work__head">
      <p class="work__marker">03 — switchMap()</p>
      <h2 class="work__title">Problems, solved</h2>
      <p class="work__lede">
        Four engagements from {yearsElapsed()} years of shipping, each as problem, approach
        and result — with the result drawn from the numbers it claims.
      </p>
    </header>

    <ol class="work__studies" role="list">
      {studies.map((study) => (
        <li class="study" data-study>
          {/* Decorative: the branch from the signal into this card. Server-rendered
              empty; the island gives it a position and a `d` once it can read the
              curve. Carries no content, so it adds no words for JS-off visitors. */}
          <svg class="study__branch" data-branch aria-hidden="true" focusable="false">
            <path data-branch-path />
          </svg>

          <div class="study__text">
            <header class="study__head">
              <p class="study__index" data-attach>{study.index}</p>
              <h3 class="study__name">{study.name}</h3>
              <p class="study__role">{study.role}</p>
            </header>

            <dl class="study__beats">
              <div class="study__beat">
                <dt>Problem</dt>
                <dd>{study.problem}</dd>
              </div>
              <div class="study__beat">
                <dt>Approach</dt>
                <dd>{study.approach}</dd>
              </div>
              <div class="study__beat study__beat--result">
                <dt>Result</dt>
                <dd>{study.result}</dd>
              </div>
            </dl>

            <ul class="study__tags" role="list">
              {study.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </div>

          <figure class="study__figure" data-figure data-diagram={JSON.stringify(study.diagram)}>
            <svg
              class="diagram"
              viewBox={viewBox}
              aria-hidden="true"
              focusable="false"
              preserveAspectRatio="xMidYMid meet"
            >
              {study.bundle && (
                <Fragment>
                  <text class="diagram__label" x={PLOT_LEFT} y={BUNDLE_BAR.y - 44}>bundle size</text>
                  <rect
                    class="diagram__ghost"
                    x={PLOT_LEFT}
                    y={BUNDLE_BAR.y}
                    width={study.bundle.start.width}
                    height={BUNDLE_BAR.height}
                  />
                  <text class="diagram__label" x={study.bundle.start.endX} y={BUNDLE_BAR.y + BUNDLE_BAR.height + 22} text-anchor="end">{study.bundle.start.label}</text>
                  <rect
                    class="diagram__bar"
                    data-part="bar"
                    x={PLOT_LEFT}
                    y={BUNDLE_BAR.y}
                    width={study.bundle.end.width}
                    height={BUNDLE_BAR.height}
                  />
                  <text class="diagram__value" data-part="bar-label" x={study.bundle.end.endX} y={BUNDLE_BAR.y - 10} text-anchor="end">{study.bundle.end.label}</text>
                  <circle class="diagram__emit" data-part="emit" cx={study.bundle.end.endX} cy={BUNDLE_BAR.y + BUNDLE_BAR.height / 2} r="6" />
                </Fragment>
              )}

              {study.repos && (
                <Fragment>
                  <text class="diagram__label" x={PLOT_LEFT} y="14">{study.repos.label} repos</text>
                  {study.repos.segments.map((segment) => (
                    <Fragment>
                      <circle class="diagram__node" cx={segment.x1} cy={segment.y1} r="3.5" />
                      <line class="diagram__line" data-part="repo" x1={segment.x1} y1={segment.y1} x2={segment.x2} y2={segment.y2} />
                    </Fragment>
                  ))}
                  <circle class="diagram__emit" data-part="emit" cx={study.repos.converge.x} cy={study.repos.converge.y} r="6" />
                  <text class="diagram__label" x={study.repos.converge.x + 14} y={study.repos.converge.y + 4}>NgRx</text>

                  <text class="diagram__label" x={PLOT_LEFT} y={DEPLOY_BAR.y - 10}>deploy</text>
                  <rect
                    class="diagram__ghost"
                    x={PLOT_LEFT}
                    y={DEPLOY_BAR.y}
                    width={study.repos.deployStart.width}
                    height={DEPLOY_BAR.height}
                  />
                  <text class="diagram__label" x={study.repos.deployStart.endX} y={DEPLOY_BAR.y + DEPLOY_BAR.height + 18} text-anchor="end">{study.repos.deployStart.label}</text>
                  <rect
                    class="diagram__bar"
                    data-part="bar"
                    x={PLOT_LEFT}
                    y={DEPLOY_BAR.y}
                    width={study.repos.deploy.width}
                    height={DEPLOY_BAR.height}
                  />
                  <text class="diagram__value" data-part="bar-label" x={study.repos.deploy.endX} y={DEPLOY_BAR.y + DEPLOY_BAR.height + 18} text-anchor="middle">{study.repos.deploy.label}</text>
                </Fragment>
              )}

              {study.frametime && (
                <Fragment>
                  <line class="diagram__axis" x1={PLOT_LEFT} y1={FRAME_BASELINE_Y} x2={PLOT_RIGHT} y2={FRAME_BASELINE_Y} />
                  <text class="diagram__label" x={PLOT_LEFT} y={FRAME_BASELINE_Y + 18}>0 ms</text>
                  <line class="diagram__budget" x1={PLOT_LEFT} y1={study.frametime.budgetY} x2={PLOT_RIGHT} y2={study.frametime.budgetY} />
                  <text class="diagram__label" x={PLOT_LEFT} y={study.frametime.budgetY - 14}>frame time · {study.frametime.msLabel}</text>
                  <path class="diagram__trace" data-part="trace" d={study.frametime.d} pathLength="1" />
                  <circle class="diagram__emit" data-part="emit" cx={study.frametime.end.x} cy={study.frametime.end.y} r="6" />
                  <text class="diagram__value" x={PLOT_RIGHT} y={study.frametime.budgetY - 14} text-anchor="end">{study.frametime.fpsLabel}</text>
                </Fragment>
              )}

              {study.scatter && (
                <Fragment>
                  <g class="diagram__cells" data-part="coarse" opacity="0">
                    {study.scatter.coarse.map((path) => (
                      <path class={`diagram__cell diagram__cell--${path.level}`} d={path.d} />
                    ))}
                  </g>
                  <g class="diagram__cells" data-part="fine">
                    {study.scatter.fine.map((path) => (
                      <path class={`diagram__cell diagram__cell--${path.level}`} d={path.d} />
                    ))}
                  </g>
                </Fragment>
              )}
            </svg>
            <figcaption class="study__caption">{study.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .work {
    padding-block: var(--section-y);
  }

  /* The content box the signal's gutter probe assumes — see the frontmatter. */
  .work__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--s-5);
    padding-left: calc(var(--s-5) + var(--signal-gutter));
  }

  /* ── Section head — the house voice, as NineYears sets it ───────────────────────── */

  .work__marker,
  .work__lede {
    margin: 0;
  }

  /* Not uppercased: `switchMap()` is an operator, and an operator in capitals stops being
     an identifier. Same rule as section 02's `scan()`. */
  .work__marker {
    color: var(--type-dim);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
  }

  .work__title {
    max-width: 18ch;
    margin: var(--s-4) 0;
    color: var(--type);
    font-family: var(--font-display);
    font-size: clamp(32px, 4.2vw, 62px);
    font-stretch: 125%;
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .work__lede {
    max-width: 52ch;
    color: var(--type-dim);
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.6;
  }

  /* ── The studies ────────────────────────────────────────────────────────────────── */

  .work__studies {
    display: flex;
    flex-direction: column;
    gap: var(--s-7);
    margin: clamp(var(--s-8), 7vw, var(--s-10)) 0 0;
    padding: 0;
    list-style: none;
  }

  .study {
    position: relative;
    display: grid;
    gap: var(--s-6);
    padding: var(--s-6);
    border: 1px solid color-mix(in srgb, var(--type) 10%, transparent);
    border-radius: var(--radius);
    background: var(--ground-lift);
  }

  @media (min-width: 1100px) {
    .study {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--s-7);
      padding: var(--s-7);
    }
  }

  /* The branch: positioned and drawn by the island, off the card's left edge. Until then
     it has no size, so with JS off there is simply no branch. */
  .study__branch {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    overflow: visible;
    pointer-events: none;
  }

  /* Placed and drawn by script, so never transitioned: global.css's reduced-motion net
     gives everything a 1ms transition, and with the default `transition-property: all`
     that would turn the island's writes into transitions that only settle on a later
     rendered frame. The same goes for every scrubbed part of a diagram. */
  .study__branch,
  .study__branch path,
  .diagram * {
    transition-property: none;
  }

  .study__branch path {
    fill: none;
    stroke: var(--signal);
    stroke-width: var(--signal-stroke);
    stroke-linecap: round;
  }

  .study__head > *,
  .study__beats,
  .study__beats dd {
    margin: 0;
  }

  .study__index {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .study__name {
    margin-top: var(--s-2);
    color: var(--type);
    font-family: var(--font-display);
    font-size: clamp(24px, 2.4vw, 34px);
    font-stretch: 112%;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.015em;
  }

  .study__role {
    margin-top: var(--s-2);
    color: var(--type-dim);
    font-size: 15px;
  }

  .study__beats {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    margin-top: var(--s-6);
  }

  .study__beat dt {
    margin-bottom: var(--s-1);
    color: var(--type-dim);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .study__beat dd {
    max-width: 62ch;
    color: var(--type);
    font-size: 15px;
    line-height: 1.6;
  }

  /* The result is the part a hiring manager reads first, so it gets a rule of its own
     rather than a colour: --signal is never body copy (§7.1). */
  .study__beat--result {
    padding-left: var(--s-4);
    border-left: 2px solid var(--shipped);
  }

  .study__beat--result dd {
    font-weight: 600;
  }

  .study__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: var(--s-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .study__tags li {
    padding: var(--s-1) var(--s-3);
    border: 1px solid color-mix(in srgb, var(--type) 16%, transparent);
    border-radius: var(--radius);
    color: var(--type-dim);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  /* ── The figure ─────────────────────────────────────────────────────────────────── */

  .study__figure {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--s-4);
    margin: 0;
  }

  .diagram {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .study__caption {
    color: var(--type-dim);
    font-size: 14px;
    line-height: 1.55;
  }

  /* Diagram paint — tokens only. --signal for the live mark, --shipped for the
     finished state (§6's emission logic), --type-dim for everything historical. */
  .diagram__label,
  .diagram__value {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  .diagram__label {
    fill: var(--type-dim);
  }

  .diagram__value {
    fill: var(--type);
    font-size: 13px;
  }

  /* SVG text scales with the figure. Below ~600px the figure is ~260px wide and 11 user
     units would render near 9px, so the labels grow to keep ~11px on screen. */
  @media (max-width: 600px) {
    .diagram__label {
      font-size: 14px;
    }

    .diagram__value {
      font-size: 16px;
    }
  }

  .diagram__ghost {
    fill: none;
    stroke: var(--type-dim);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }

  .diagram__bar {
    fill: var(--signal);
  }

  .diagram__node {
    fill: var(--ground-lift);
    stroke: var(--type-dim);
    stroke-width: 1.5;
  }

  .diagram__line,
  .diagram__trace {
    fill: none;
    stroke: var(--signal);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .diagram__axis {
    stroke: color-mix(in srgb, var(--type) 18%, transparent);
    stroke-width: 1;
  }

  .diagram__budget {
    stroke: var(--type-dim);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }

  .diagram__emit {
    fill: var(--shipped);
    transform-box: fill-box;
    transform-origin: center;
  }

  .diagram__cells {
    shape-rendering: crispEdges;
  }

  .diagram__cell {
    fill: var(--signal);
  }

  .diagram__cell--1 { fill-opacity: 0.1; }
  .diagram__cell--2 { fill-opacity: 0.32; }
  .diagram__cell--3 { fill-opacity: 0.62; }
  .diagram__cell--4 { fill-opacity: 1; }
</style>

<script>
  import { mountWork } from '../islands/work';

  mountWork();
</script>
